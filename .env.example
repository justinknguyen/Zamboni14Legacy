# Copy this file to .env and fill in your values.
#   cp .env.example .env

# Your router's public IP address (or a DDNS hostname resolved to an IP).
# This is what RPCS3 clients will connect to.
GAME_SERVER_IP=YOUR_PUBLIC_IP

# Strong password for the PostgreSQL zamboni user.
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Optional overrides (defaults shown):
# GAME_SERVER_PORT=16767
# LOG_LEVEL=Info
